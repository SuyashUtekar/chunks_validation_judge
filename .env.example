# Copy this file to .env and set your own LiteLLM proxy details.
# Do not commit .env or place real credentials in this example.
JUDGE_LLM_BASE_URL=http://127.0.0.1:4000/v1
JUDGE_LLM_MODEL=your-litellm-model-alias
JUDGE_LLM_API_KEY=your-litellm-virtual-key
JUDGE_LLM_TIMEOUT_SECONDS=120
JUDGE_LLM_MAX_WORKERS=4
JUDGE_LLM_JSON_MODE=true
JUDGE_LLM_ALLOW_REMOTE=false

# Optional local report storage override
# JUDGE_DATA_DIR=./data/evaluations
